{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "modules/**/*.ts",
    "modules/**/*.tsx",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "catalog/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".kit"]
}
