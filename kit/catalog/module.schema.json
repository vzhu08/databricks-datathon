{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "tags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "useCases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "string",
      "enum": [
        "universal",
        "node",
        "browser",
        "python",
        "mixed"
      ]
    },
    "environments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "string"
    },
    "entrypoints": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "exports": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimalRead": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "optionalIntegrations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "when": {
            "type": "string",
            "enum": [
              "local",
              "live",
              "optional"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "required",
          "secret",
          "when",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "systemRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integration": {
      "type": "object",
      "properties": {
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "steps",
        "routes",
        "migrations",
        "assets"
      ],
      "additionalProperties": false
    },
    "contracts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "examples": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixtures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modes": {
      "type": "object",
      "properties": {
        "local": {
          "type": "string",
          "minLength": 5
        },
        "live": {
          "type": "string",
          "minLength": 5
        }
      },
      "required": [
        "local",
        "live"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "string",
          "enum": [
            "implemented",
            "partial"
          ]
        },
        "local": {
          "type": "string"
        },
        "exported": {
          "type": "string"
        },
        "live": {
          "type": "string"
        },
        "record": {
          "type": "string"
        }
      },
      "required": [
        "implementation",
        "local",
        "exported",
        "live",
        "record"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cost": {
      "type": "string"
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "tags",
    "useCases",
    "runtime",
    "environments",
    "source",
    "entrypoints",
    "exports",
    "minimalRead",
    "dependencies",
    "packages",
    "optionalIntegrations",
    "env",
    "systemRequirements",
    "integration",
    "contracts",
    "examples",
    "fixtures",
    "checks",
    "modes",
    "verification",
    "limitations",
    "cost",
    "docs",
    "license",
    "provenance"
  ],
  "additionalProperties": false
}
