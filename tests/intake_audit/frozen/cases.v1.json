  "population": "Independent deliberate fictional software challenges; not a clinical or national accuracy sample.",
  "basis": [
    "#124 acceptance criteria and orchestration acceptance 7073694662",
    "#127 consumer direction 7073777400",
    "#133 initial independent audit assignment"
  ],
  "state_semantics": {
    "ready": "A confirmed current synthetic request is eligible for the offline finder.",
    "emergency_escalation": "Warning escalation without ordinary ranking.",
    "needs_more_information": "Incomplete/ambiguous inputs or missing valid summary confirmation.",
    "clinician_assessment_needed": "Simulated clinical authority absent or insufficient.",
    "unsupported_care_need": "Unsupported concern or population is explicitly withheld.",
    "invalid_input": "Malformed or untrusted input is rejected.",
    "error": "Visible failure without reusing a prior recommendation."
  },
  "baselines": {
    "complete_<service>": "Trusted fictional adult nonpregnant scenario, supported scope, all structured warnings negative, complete onset/severity, matching prior simulated clinical authority, explicit routine urgency and empty required capabilities, synthetic provenance, no summary confirmation initially.",
    "no_clinician_authority": "Same complete fictional safety/context inputs but no service request or prior clinician authority."
  },
  "adapter_rules": [
    "Translate semantics into the approved contract without changing case intent or expectation.",
    "If a semantic input is not representable, record NOT_RUN and the reason, never silently drop it.",
    "For multi-phase stale-state cases, require the initial ready phase to succeed before counting the blocked second phase.",
    "Only S may change the adapter; changing frozen cases creates a new edition and preserves the original digest.",
    "All live calls must be instrumented and denied. Blocked cases require zero finder calls; ready controls require exactly one offline finder invocation.",
    "Allowed state sets acknowledge unresolved API naming/precedence only; readiness and request/service/call constraints are fixed.",
    "Input exceptions count as invalid_input only if they are expected validation errors and the downstream consumer clears prior results. Unexpected exceptions are errors, not successful abstention."
  ],
